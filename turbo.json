{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "deploy": {
      "cache": false,
      "interactive": true
    },
    "destroy": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalEnv": [
    "AI_VISION_MODEL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "CORS_ORIGIN",
    "EXPO_PUBLIC_SERVER_URL",
    "NODE_ENV",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "DEV_LOGIN",
    "STRAVA_CLIENT_ID",
    "STRAVA_CLIENT_SECRET",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "VITE_SERVER_URL",
    "_VARLOCK_ENV_KEY",
    "AI_BENCH_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
