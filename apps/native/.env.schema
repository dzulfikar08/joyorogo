# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# @required=false
# @public @type=string
EXPO_PUBLIC_DEV_LOGIN=

# Facebook App ID for Instagram Stories direct share (com.instagram.share.ADD_TO_STORY).
# Empty/missing: the story PNG goes through the system share sheet instead.
# @required=false
# @public @type=string
EXPO_PUBLIC_FB_APP_ID=

# Origin situs web tempat aset gambar tips dilayani (/tips-img/...).
# Kosong: pakai default https://joyorogo.com di kode.
# @required=false
# @public @type=url
EXPO_PUBLIC_WEB_URL=
