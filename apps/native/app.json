{
  "expo": {
    "name": "JoyoRogo",
    "slug": "joyorogo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "joyorogo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.joyodigitama.joyorogo",
      "buildNumber": "1",
      "appleTeamId": "F6Q6UFUK69",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Izinkan JoyoRogo membaca langkah, jarak, kalori aktif, olahraga, dan tidur dari Apple Health untuk menghitung kalori yang kamu bakar."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F6F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joyodigitama.joyorogo",
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan kamera untuk memotret makananmu dan menghitung kalorinya."
        }
      ],
      "react-native-health-connect",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F1",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#141311"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Izinkan mikrofon untuk merekam cerita makananmu dan menghitung kalorinya.",
          "recordAudioAndroid": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/widget/fonts/PlusJakartaSans_500Medium.ttf",
            "./assets/widget/fonts/PlusJakartaSans_700Bold.ttf",
            "./assets/widget/fonts/PlusJakartaSans_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "ProgresHariIni",
              "label": "Progres Hari Ini",
              "description": "Kalori makan hari ini dibanding target, plus protein.",
              "minWidth": "110dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/progres-hari-ini.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KotakMasukGrup",
              "label": "Kotak Masuk Grup",
              "description": "Colek dan catatan terbaru dari teman grupmu.",
              "minWidth": "110dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/kotak-masuk-grup.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Ringkasan",
              "label": "Ringkasan JoyoRogo",
              "description": "Progres kalori hari ini dan kabar terbaru dari grupmu dalam satu kotak.",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/ringkasan.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      // Empty props: the plugin reads props.android and crashes prebuild
      // when mounted bare with undefined props.
      [
        "react-native-share",
        {
          "android": ["com.instagram.android"],
          "ios": ["instagram", "instagram-stories"]
        }
      ],
      "./plugins/with-widget-headless-fix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
