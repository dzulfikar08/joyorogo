{
  "expo": {
    "name": "JoyoRogo",
    "slug": "joyorogo",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "joyorogo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joyodigitama.joyorogo",
      "buildNumber": "2",
      "appleTeamId": "F6Q6UFUK69",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSHealthShareUsageDescription": "Izinkan JoyoRogo membaca langkah, jarak, kalori aktif, olahraga, dan tidur dari Apple Health untuk menghitung kalori yang kamu bakar.",
        "NSHealthUpdateUsageDescription": "JoyoRogo hanya membaca data dari Apple Health dan tidak menulis apa pun ke sana."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.security.application-groups": ["group.com.joyodigitama.joyorogo"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#157040",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joyodigitama.joyorogo",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan kamera untuk memotret makananmu, menghitung kalorinya, dan memindai barcode kemasan.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan lokasi supaya JoyoRogo bisa menyimpan tempat makanmu. Hanya perkiraan sekitar 100 m, tersimpan pribadi, dan cuma kamu yang bisa melihatnya.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#137D41"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F1",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#141311"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Izinkan mikrofon untuk merekam cerita makananmu dan menghitung kalorinya.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Izinkan mikrofon untuk merekam cerita makananmu dan menghitung kalorinya.",
          "speechRecognitionPermission": "Izinkan pengenalan suara supaya ucapan koreksimu langsung tampil sebagai teks. Suara bisa diproses oleh Apple untuk diubah jadi teks.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Izinkan JoyoRogo menambahkan gambar story ke galeri kamu. Foto lainmu tidak dibaca.",
          "granularPermissions": []
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/widget/fonts/PlusJakartaSans_500Medium.ttf",
            "./assets/widget/fonts/PlusJakartaSans_700Bold.ttf",
            "./assets/widget/fonts/PlusJakartaSans_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "ProgresHariIni",
              "label": "Progres Hari Ini",
              "description": "Kalori makan hari ini dibanding target, plus protein.",
              "minWidth": "110dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/progres-hari-ini.png",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "KotakMasukGrup",
              "label": "Kotak Masuk Grup",
              "description": "Colek dan catatan terbaru dari teman grupmu.",
              "minWidth": "110dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/kotak-masuk-grup.png",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "Ringkasan",
              "label": "Ringkasan JoyoRogo",
              "description": "Progres kalori hari ini dan kabar terbaru dari grupmu dalam satu kotak.",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/ringkasan.png",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "FotoMakanan",
              "label": "Scan Makanan",
              "description": "Ketuk untuk membuka kamera dan mencatat makanan dari foto.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "previewImage": "./assets/widget-preview/foto-makanan.png"
            },
            {
              "name": "StreakCatat",
              "label": "Streak Catat",
              "description": "Hari beruntun kamu mencatat makan, ditemani Joyo. Ketuk untuk scan makanan.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/streak-catat.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      // Empty props: the plugin reads props.android and crashes prebuild
      // when mounted bare with undefined props.
      [
        "react-native-share",
        {
          "android": ["com.instagram.android"],
          "ios": ["instagram", "instagram-stories"]
        }
      ],
      "@bacons/apple-targets",
      "./plugins/with-widget-headless-fix",
      "./plugins/with-no-location-service"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/808b0d66-86af-4b95-835d-904c89803103",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "808b0d66-86af-4b95-835d-904c89803103"
      }
    },
    "owner": "dzulfikar08"
  }
}
