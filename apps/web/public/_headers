# Vite emits content-hashed filenames under /assets, so they never change in
# place: cache them forever instead of revalidating every file on every load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400

# Service worker harus selalu divalidasi: versi lama jangan mengganggu
# pendaftaran push yang baru.
/sw.js
  Cache-Control: no-cache
