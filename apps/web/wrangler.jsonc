{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyorogo-web-live-dzul-fqqmlyfh7l3bif2g",
  "account_id": "b7e6f8457bd39fa37a7eea5249799754",
  // Only the share routes below run this script (link-preview tags); every
  // other request is served from the asset store without invoking it.
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  // A zone route, not a custom domain: the apex already has proxied DNS
  // records from the zone import, and a route takes over every path on them.
  "routes": [{ "pattern": "joyorogo.com/*", "zone_name": "joyorogo.com" }],
  "vars": {
    "API_URL": "https://api.joyorogo.com",
    "SITE_URL": "https://joyorogo.com",
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/gabung/*", "/p/*", "/u/*", "/assets/*"],
  },
}
