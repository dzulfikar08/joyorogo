{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b ../../packages/api && vite build",
    "serve": "vite preview",
    "start": "vite",
    "check-types": "tsc -b ../../packages/api && vite build && tsc --noEmit && tsc --noEmit -p worker",
    "dev:bare": "vite dev",
    "env:generate": "varlock codegen",
    "og": "chromium --headless --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 --screenshot=public/og.png og/og-image.html"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@joyorogo/api": "workspace:*",
    "@joyorogo/ui": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "5.102.8",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "catalog:",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "catalog:",
    "maplibre-gl": "5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@joyorogo/config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "marked": "^18.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
