{
  "references": [{ "path": "../../packages/api" }],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "rootDirs": ["."],
    "paths": {
      "@/*": ["./src/*"],
      "@joyorogo/ui/*": ["../../packages/ui/src/*"]
    }
  },
  // worker/ targets the Workers runtime types, not the DOM: it has its own tsconfig.
  // *.test.ts run under bun test, which the browser tsconfig has no types for.
  "exclude": ["worker", "dist", "node_modules", "src/**/*.test.ts"]
}
