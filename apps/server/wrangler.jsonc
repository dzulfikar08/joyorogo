{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyorogo-server-live-dzul-btifrf7qulj3wn55",
  "account_id": "b7e6f8457bd39fa37a7eea5249799754",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.joyorogo.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joyorogo-database-live-dzul-unqpixpckdt72ct3",
      "database_id": "9c08fc88-df8e-4160-99fd-740bd3072843",
      "migrations_dir": "../../packages/db/src/migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "INVITE_PREVIEW_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "REVIEW_LOGIN_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "MCP_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "OAUTH_REGISTER_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "joyorogo-downloads"
    },
    {
      "binding": "STICKERS",
      "bucket_name": "joyorogo-scans"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "http://localhost:3001,http://localhost:3002,http://localhost:3003,https://joyorogo-web-live-dzul-fqqmlyfh7l3bif2g.dzulfikar-at.workers.dev,https://joyorogo.com,https://app.joyorogo.com,https://admin.joyorogo.com,https://app.fit.joyorogo.com",
    "BETTER_AUTH_URL": "https://api.joyorogo.com",
    "GOOGLE_CLIENT_ID": "915036968874-0ne1edkq0laljg6cdlnksor1hqpj9gfr.apps.googleusercontent.com",
    "DEV_LOGIN": "",
    "AI_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "DATASET_USER_IDS": "CVSNDwC3Fx2V5KuNtJ0jwzl29KhbkMjc",
    "PORTION_PRIOR_USER_IDS": "CVSNDwC3Fx2V5KuNtJ0jwzl29KhbkMjc",
    "DISHWARE_USER_IDS": "CVSNDwC3Fx2V5KuNtJ0jwzl29KhbkMjc",
    "CORRECTION_MEMORY_USER_IDS": "CVSNDwC3Fx2V5KuNtJ0jwzl29KhbkMjc",
    "SCALE_READOUT_USER_IDS": "CVSNDwC3Fx2V5KuNtJ0jwzl29KhbkMjc",
    "SHADOW_SAMPLE_RATE": "0.2",
    "SHADOW_DAILY_CAP": "60",
    // The signed-in app (docs/app-subdomain.md); SITE_URL is the landing/marketing site.
    "APP_URL": "https://app.joyorogo.com",
    "SITE_URL": "https://joyorogo.com",
    // The JoyoFit cloud API that /api/fit/* (the JoyoFit web app) forwards to.
    "JOYOFIT_API_URL": "https://api.fit.joyorogo.com",
    "FREE_DAILY_SCANS": "3",
    // Coach chat (docs/coach.md): messages per user per WIB day; "0" turns it off. Optional AI_COACH_MODEL overrides the model.
    "COACH_DAILY_CAP": "20",
    // Weekly reflection AI text (docs/weekly-recap-ai.md): optional AI_RECAP_MODEL overrides the model, unset = AI_VISION_MODEL's default (Gemma 4).
    "FOUNDER_DAILY_CAP": "100",
    "ANON_SCANS": "2",
    "FOUNDER_PRICE_IDR": "15000",
    "FOUNDER_YEARLY_PRICE_IDR": "199000",
    "FOUNDER_PRICE_LADDER": "10:15000/149000,110:29000/199000,:49000/349000",
    "ADMIN_EMAILS": "dzulfikar.at@gmail.com",
    "REVIEW_LOGIN_EMAILS": "review@joyorogo.com,qa@joyorogo.com",
    "EMAIL_FROM": "halo@mail.joyorogo.com",
    "EMAIL_FROM_NAME": "JoyoRogo",
    "EMAIL_REPLY_TO": "dzulfikar.at@gmail.com",
    "BILLING_PROVIDER": "doku",
    "DOKU_CLIENT_ID": "BRN-0177-1790860845392",
    "DOKU_BASE_URL": "https://api.doku.com",
    "PAKASIR_SLUG": "joyorogo",
    // Polar USD checkout (docs/pricing.md). Secrets POLAR_ACCESS_TOKEN and POLAR_WEBHOOK_SECRET are set with wrangler secret put.
    "POLAR_PRODUCT_MONTHLY_ID": "0eccddaa-1f8d-404c-b68c-7bfc99026f0c",
    "POLAR_PRODUCT_YEARLY_ID": "52630e7f-e269-4998-8064-f1b375a200a8",
    "POLAR_PRICE_MONTHLY_USD_CENTS": "999",
    "POLAR_PRICE_YEARLY_USD_CENTS": "5999",
    "APPLE_BUNDLE_ID": "com.joyodigitama.joyorogo",
    "APPLE_SANDBOX_EMAILS": "",
    "TESTFLIGHT_PURCHASE_EMAIL": "on",
    // Native update gate (docs/force-update.md). 0 = off. Set after the fixed build is live in Play / TestFlight.
    "MIN_BUILD_ANDROID": "1471904",
    "LATEST_BUILD_ANDROID": "1471904",
    "MIN_BUILD_IOS": "0",
    "LATEST_BUILD_IOS": "0"
  }
}