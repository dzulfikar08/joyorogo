{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyorogo-server-live-dzul-btifrf7qulj3wn55",
  "account_id": "b7e6f8457bd39fa37a7eea5249799754",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.joyorogo.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joyorogo-database-live-dzul-unqpixpckdt72ct3",
      "database_id": "9c08fc88-df8e-4160-99fd-740bd3072843",
      "migrations_dir": "../../packages/db/src/migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "INVITE_PREVIEW_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "REVIEW_LOGIN_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "joyorogo-downloads"
    },
