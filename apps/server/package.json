{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsrs -b ../../packages/api && tsdown",
    "check-types": "tsrs -b ../../packages/api && tsrs --noEmit",
    "test": "bun test src",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@joyorogo/api": "workspace:*",
    "@joyorogo/auth": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@joyorogo/db": "workspace:*",
    "@joyorogo/i18n": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@joyorogo/config": "workspace:*",
    "@joyorogo/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
