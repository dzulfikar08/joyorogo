# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# Extra API origins still served after a domain move (comma-separated), e.g.
# the old host that installed apps keep calling. Sign-in requests arriving on
# one of these run with it as their base URL, so OAuth callbacks and cookies
# stay on the host that started the flow.
# @required=false
# @public @type=string
BETTER_AUTH_ALT_URLS=

# @required=false
# @public @type=string
GOOGLE_CLIENT_ID=

# @required=false
# @type=string
GOOGLE_CLIENT_SECRET=

# @required=false
# @public @type=string
AI_VISION_MODEL=

# @required=false
# @public @type=string
STRAVA_CLIENT_ID=

# @required=false
# @type=string
STRAVA_CLIENT_SECRET=

# Any non-empty value enables the credentialless dev sign-in endpoint
# (local verification only — never set in production)
# @type=string
DEV_LOGIN=

# @public @dynamic @type=string
CORS_ORIGIN=

# Public web app origin, used for the payment return page. Leave empty when
# the API and web share one origin (defaults to BETTER_AUTH_URL).
# @required=false
# @public @type=string
APP_URL=

# --- Paywall (each operator decides) -----------------------------------------
# Daily AI photo scans for free users. Empty = no paywall: unlimited scans,
# no pricing page, no upgrade prompts. JoyoRogo Cloud uses 3.
# @required=false
# @public @type=string
FREE_DAILY_SCANS=

# Daily cost-safety cap for Founder users. Empty = uncapped. Cloud uses 100.
# @required=false
# @public @type=string
FOUNDER_DAILY_CAP=

# Anonymous landing-page scans per device. Empty = 2, 0 turns the demo off.
# @required=false
# @public @type=string
ANON_SCANS=

# Founder price per month in Rupiah. Empty = 15000.
# @required=false
# @public @type=string
FOUNDER_PRICE_IDR=

# --- DOKU Checkout (Founder payments) -----------------------------------------
# Checkout turns on only when FREE_DAILY_SCANS and both DOKU keys are set.
# @required=false
# @public @type=string
DOKU_CLIENT_ID=

# @required=false
# @type=string
DOKU_SECRET_KEY=

# Empty = production (https://api.doku.com); sandbox: https://api-sandbox.doku.com
# @required=false
# @public @type=string
DOKU_BASE_URL=

