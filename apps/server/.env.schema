# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @required=false
# @public @type=string
GOOGLE_CLIENT_ID=

# @required=false
# @type=string
GOOGLE_CLIENT_SECRET=

# @required=false
# @public @type=string
AI_VISION_MODEL=

# @required=false
# @public @type=string
STRAVA_CLIENT_ID=

# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup): enables the USDA barcode source
# @required=false
# @type=string
USDA_FDC_API_KEY=

# @required=false
# @type=string
STRAVA_CLIENT_SECRET=

# Any non-empty value enables the credentialless dev sign-in endpoint
# (local verification only — never set in production)
# @type=string
DEV_LOGIN=

# @public @dynamic @type=string
CORS_ORIGIN=

# Public web app origin (the signed-in app): payment return page, MCP consent,
# links in emails. Leave empty when the API and web share one origin (defaults
# to BETTER_AUTH_URL). JoyoRogo Cloud: https://app.joyorogo.com
# @required=false
# @public @type=string
APP_URL=

# Origin of the landing/marketing site (pricing and privacy pages), when it is a
# different host from APP_URL (docs/app-subdomain.md). Empty = APP_URL.
# @required=false
# @public @type=string
SITE_URL=

# --- Paywall (each operator decides) -----------------------------------------
# Daily AI photo scans for free users. Empty = no paywall: unlimited scans,
# no pricing page, no upgrade prompts. JoyoRogo Cloud uses 3.
# @required=false
# @public @type=string
FREE_DAILY_SCANS=

# Daily cost-safety cap for Founder users. Empty = uncapped. Cloud uses 100.
# @required=false
# @public @type=string
FOUNDER_DAILY_CAP=

# Anonymous landing-page scans per device. Empty = 2, 0 turns the demo off.
# @required=false
# @public @type=string
ANON_SCANS=

# Founder price per month in Rupiah. Dipakai saat FOUNDER_PRICE_LADDER kosong.
# Empty = 15000.
# @required=false
# @public @type=string
FOUNDER_PRICE_IDR=

# Founder price per year in Rupiah. Empty = 10x the monthly price. Flat yearly
# price and fallback for Apple/Play orders not billed in IDR; also the yearly
# of ladder steps without an explicit "/yearly" (capped at 10x their monthly).
# @required=false
# @public @type=string
FOUNDER_YEARLY_PRICE_IDR=

# Urgency ladder "buyers:monthlyIdr[/yearlyIdr]" steps, e.g.
# "10:15000/149000,110:29000/199000,:49000/349000": the first 10 paying
# Founders pay Rp15.000/bulan or Rp149.000/tahun, buyers 11-110 pay Rp29.000 /
# Rp199.000, then Rp49.000 / Rp349.000 (last step may be open-ended ":49000/349000").
# Buyers = distinct users with at least one paid payment. Anyone who has paid
# before keeps their lowest paid monthly-equivalent price ("harga terkunci").
# Empty = flat FOUNDER_PRICE_IDR without promo.
# @required=false
# @public @type=string
FOUNDER_PRICE_LADDER=

# Google emails (comma-separated) allowed into the admin console API
# (/api/admin/*, served to admin.joyorogo.com). Empty = admin off.
# @required=false
# @type=string
ADMIN_EMAILS=

# User ids (comma-separated) whose scans are kept as the internal accuracy
# dataset in R2 (dataset/<userId>/<scanId>/: photo, AI answer, corrections,
# final diary items; see packages/api/src/lib/dataset.ts and /privasi).
# Empty = nobody. Everyone else's photos are discarded after analysis.
# @required=false
# @type=string
DATASET_USER_IDS=

# User ids (comma-separated) that get "Porsi kebiasaanmu" on photo scans: an item
# starts at the user's usual weighed portion (from weights they typed or edited)
# and the model's own number stays one tap away. See
# packages/api/src/lib/portion-prior.ts. Empty = nobody, scans unchanged.
# @required=false
# @type=string
PORTION_PRIOR_USER_IDS=

# User ids (comma-separated) that get "Piring saya": plates and bowls registered with their size, sent
# to the photo scan so portions are read against a known diameter (docs/dishware.md).
# Empty = nobody; scans are answered as before and the screen stays hidden.
# @required=false
# @type=string
DISHWARE_USER_IDS=

# User ids (comma-separated) that get the kitchen-scale readout on photo scans: when
# the photo shows a scale display the model reads the digits and those grams replace
# its estimate ("Terbaca dari timbangan: 100 g", the photo estimate one tap away).
# See packages/api/src/lib/scale-reading.ts. Empty = nobody, scans unchanged.
# @required=false
# @type=string
SCALE_READOUT_USER_IDS=

# Emails (comma-separated) allowed to sign in with email + password: the
# Google Play / App Store review account. Sign-up by email is always off; the
# account is created by scripts/review-login.ts. Empty = email sign-in off.
# @required=false
# @type=string
REVIEW_LOGIN_EMAILS=

# --- Founder payments: DOKU Checkout and/or Pakasir ---------------------------
# Checkout turns on only when FREE_DAILY_SCANS and a gateway's keys are set.
# Buyers pick "QRIS" (Pakasir, QR-only link) or "Transfer Bank" (DOKU); each
# button shows only when its gateway is configured. BILLING_PROVIDER is the
# gateway for checkouts that name no method (older app builds): "doku" or
# "pakasir"; empty = DOKU if configured, else Pakasir. Webhooks of every
# configured gateway stay live.
# @required=false
# @public @type=string
BILLING_PROVIDER=

# DOKU webhook: <api>/api/billing/webhook (sent per checkout, nothing to set).
# @required=false
# @public @type=string
DOKU_CLIENT_ID=

# @required=false
# @type=string
DOKU_SECRET_KEY=

# Empty = production (https://api.doku.com); sandbox: https://api-sandbox.doku.com
# @required=false
# @public @type=string
DOKU_BASE_URL=

# Pakasir v2. Dashboard > project detail: slug, API key, webhook secret. Set
# the project's webhook URL to <api>/api/billing/pakasir/webhook.
# @required=false
# @public @type=string
PAKASIR_SLUG=

# @required=false
# @type=string
PAKASIR_API_KEY=

# @required=false
# @type=string
PAKASIR_WEBHOOK_SECRET=

# "1" lets Pakasir sandbox-mode payments grant Founder (testing only).
# @required=false
# @public @type=string
PAKASIR_SANDBOX=

# --- Polar (USD, merchant of record): web Pro for buyers outside Indonesia ----
# Off until the token, webhook secret and both product ids are set (and the paywall is on).
# Webhook: <api>/api/billing/polar/webhook, events order.paid, order.refunded and
# subscription.active|canceled|uncanceled|revoked|updated. Prices here are what /api/config
# shows in US cents; the Polar product prices are what is charged, keep them equal.
# @required=false
# @type=string
POLAR_ACCESS_TOKEN=

# @required=false
# @type=string
POLAR_WEBHOOK_SECRET=

# "sandbox" = sandbox-api.polar.sh; empty = production.
# @required=false
# @public @type=string
POLAR_SERVER=

# @required=false
# @public @type=string
POLAR_PRODUCT_MONTHLY_ID=

# @required=false
# @public @type=string
POLAR_PRODUCT_YEARLY_ID=

# Empty = 999 (US$9.99).
# @required=false
# @public @type=string
POLAR_PRICE_MONTHLY_USD_CENTS=

# Empty = 5999 (US$59.99).
# @required=false
# @public @type=string
POLAR_PRICE_YEARLY_USD_CENTS=

# --- Apple in-app purchase (iOS Founder) --------------------------------------
# The route turns on when FREE_DAILY_SCANS is set; these only override the
# defaults. Both must match the App Store Connect product for the bundle.
# APPLE_BUNDLE_ID is also the audience of native Sign in with Apple identity
# tokens (no Services ID, key or secret needed for that).
# @required=false
# @public @type=string
APPLE_BUNDLE_ID=

# Sign in with Apple token revocation (required by App Store 5.1.1(v) when an
# Apple-linked account is deleted). Create a Sign in with Apple key in the
# developer portal; SIWA_KEY_ID is its Key ID and SIWA_PRIVATE_KEY the .p8
# contents (PKCS8 PEM, `wrangler secret put`). Client id = APPLE_BUNDLE_ID.
# Missing key = deletion still works but the Apple token is NOT revoked (logged).
# APPLE_TEAM_ID defaults to F6Q6UFUK69.
# @required=false
# @public @type=string
APPLE_TEAM_ID=

# @required=false
# @public @type=string
APPLE_SIWA_KEY_ID=

# @required=false
# @type=string
APPLE_SIWA_PRIVATE_KEY=

# Emails (comma separated, case-insensitive) that may credit full Sandbox
# months: your own TestFlight account and the App Review demo account. Any
# other Sandbox buyer (App Review, TestFlight) gets a 1-day Founder trial at
# Rp0 instead of a rejection.
# @required=false
# @public @type=string
APPLE_SANDBOX_EMAILS=

# "on" mails each user once, from dzulfikar@joyorogo.com, after a TestFlight
# (Sandbox) purchase: it is Apple's simulation, nothing is charged, Pro lasts
# 24h, and a real purchase is on the web. Also mails earlier sandbox buyers
# (cron sweep). Set off when the App Store version is live (docs/pricing.md).
# @required=false
# @public @type=string
TESTFLIGHT_PURCHASE_EMAIL=

# --- Native update gate (docs/force-update.md) ---------------------------
# Minimum native build per platform (Android versionCode / iOS CFBundleVersion).
# Builds below it see a blocking "Update dulu" screen; 0 or empty = gate off.
# LATEST_* only shows a dismissible "Ada versi baru" banner on iOS.
# @required=false
# @public @type=string
MIN_BUILD_ANDROID=
# @required=false
# @public @type=string
LATEST_BUILD_ANDROID=
# @required=false
# @public @type=string
MIN_BUILD_IOS=
# @required=false
# @public @type=string
LATEST_BUILD_IOS=
# https store page overrides (defaults: Play listing / public TestFlight link).
# @required=false
# @public @type=string
ANDROID_STORE_URL=
# @required=false
# @public @type=string
IOS_STORE_URL=
# One-line reason shown on the blocking screen (max 200 chars); empty = built-in text.
# @required=false
# @public @type=string
UPDATE_MESSAGE=

# --- Google Play Billing (Play build Pro subscription) ---------------------
# Off until GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is set (and the paywall is on). Set
# these with `wrangler secret put` so they survive deploys. Steps: docs/play-billing.md.
# Service account key JSON with Android Publisher access (the whole file).
# @required=false
# @type=string
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Defaults to com.joyodigitama.joyorogo.
# @required=false
# @type=string
GOOGLE_PLAY_PACKAGE_NAME=

# Emails (comma separated, case-insensitive) whose Play license-tester purchases
# credit full periods. Any other test purchase gets a 1-day Founder trial at Rp0.
# @required=false
# @type=string
GOOGLE_PLAY_TEST_EMAILS=

# Real-time developer notifications (Pub/Sub push to /api/billing/google/rtdn).
# Either: the push subscription's service account email (Google-signed JWT, the
# audience is the endpoint URL), or a shared token appended as ?token=.
# @required=false
# @type=string
GOOGLE_PLAY_RTDN_PUSH_EMAIL=

# @required=false
# @type=string
GOOGLE_PLAY_RTDN_TOKEN=

# --- Email transaksional (Cloudflare Email Service) ----------------------------
# Semua kosong = email mati (aman untuk self-host). Butuh binding send_email
# bernama EMAIL dan domain pengirim yang sudah di-onboard di dashboard
# Cloudflare (Email Service). Lihat bagian "Email" di README.
# @required=false
# @public @type=string
EMAIL_FROM=

# @required=false
# @public @type=string
EMAIL_FROM_NAME=

# Balasan diarahkan ke alamat ini (opsional, misal email pemilik).
# @required=false
# @public @type=string
EMAIL_REPLY_TO=

# --- Web Push (puasa intermiten) -----------------------------------------------
# All three must be set or fasting reminders stay off. Generate a pair with
# `npx web-push generate-vapid-keys --json`: the public key is base64url of
# the 65-byte uncompressed P-256 point, the private key of the 32-byte `d`.
# @required=false
# @public @type=string
VAPID_PUBLIC_KEY=

# @required=false
# @type=string
VAPID_PRIVATE_KEY=

# @required=false
# @public @type=string
VAPID_SUBJECT=

# --- Push notifications to phones (Expo Push Service, docs/push.md) ---------------
# Optional. Only needed if "enhanced push security" is turned on for an EAS project
# (then it must be an access token of the account that owns both the JoyoRogo and the
# JoyoFit project). Without it the Worker sends anonymously.
# @required=false
# @type=string
EXPO_ACCESS_TOKEN=

