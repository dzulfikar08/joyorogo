// JoyoRogo as ONE worker: the Hono API (apps/server) serves the API paths,
// the web build (apps/web, built with VITE_SERVER_URL=/) serves everything
// else. Used two ways:
//   - CloudAgni: `agni publish apps/selfhost` packs this config; CloudAgni
//     fills BETTER_AUTH_URL/APP_URL, generates BETTER_AUTH_SECRET, creates
//     the D1 + R2, and asks the deployer for `cloudagni_inputs`.
//   - Your own Cloudflare account: see the README section "Self-host".
// The hosted JoyoRogo Cloud runs from apps/server + apps/web instead.
{
  "$schema": "../server/node_modules/wrangler/config-schema.json",
  "name": "joyorogo",
  "main": "../server/src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // Puasa intermiten: Web Push reminders every 5 minutes (no-op unless
  // VAPID_* secrets are set and users subscribe).
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/rpc/*",
      "/api-reference/*",
      "/ai/*",
      "/u/*",
      "/sticker/*",
      "/photo/*",
      "/avatar/*",
      "/downloads/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joyorogo",
      // Self-host: `bunx wrangler d1 create joyorogo`, then paste the id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations-deploy",
    },
  ],
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  // The invite preview works before sign-in, so it gets a per-IP budget.
  "ratelimits": [
    {
      "name": "INVITE_PREVIEW_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "r2_buckets": [{ "binding": "STICKERS", "bucket_name": "joyorogo-stickers" }],
  "vars": {
    // Your public origin, e.g. https://joyorogo.example.com (CloudAgni fills both).
    "BETTER_AUTH_URL": "https://joyorogo.example.com",
    "APP_URL": "https://joyorogo.example.com",
    // Same origin: no cross-origin callers to allow.
    "CORS_ORIGIN": "",
    "AI_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "DEV_LOGIN": "",
  },
  // CloudAgni generates these per instance (self-host: `wrangler secret put`).
  "cloudagni_secrets": ["BETTER_AUTH_SECRET"],
  // CloudAgni deploy form. {origin} renders as the instance URL.
  "cloudagni_inputs": [
    {
      "name": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth Client ID",
      "description": "Buat OAuth client (Web application) di Google Cloud Console. Authorized JavaScript origin: {origin}. Authorized redirect URI: {origin}/api/auth/callback/google",
      "required": true,
      "placeholder": "123456789-xxxx.apps.googleusercontent.com",
      "docs_url": "https://console.cloud.google.com/apis/credentials",
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth Client Secret",
      "secret": true,
      "required": true,
      "placeholder": "GOCSPX-...",
    },
    {
      "name": "STRAVA_CLIENT_ID",
      "label": "Strava Client ID",
      "description": "Opsional, untuk impor olahraga dari Strava. Authorization Callback Domain: domain dari {origin}",
      "docs_url": "https://www.strava.com/settings/api",
    },
    { "name": "STRAVA_CLIENT_SECRET", "label": "Strava Client Secret", "secret": true },
    {
      "name": "FREE_DAILY_SCANS",
      "label": "Batas scan AI gratis per hari",
      "description": "Kosongkan untuk tanpa batas (tanpa paywall). Isi angka, misalnya 3, untuk membatasi pengguna gratis.",
    },
    {
      "name": "FOUNDER_DAILY_CAP",
      "label": "Batas scan AI Founder per hari",
      "description": "Kosongkan untuk tanpa batas.",
    },
    {
      "name": "ANON_SCANS",
      "label": "Coba scan tanpa daftar per perangkat",
      "description": "Kosong = 2. Isi 0 untuk mematikan demo di halaman depan.",
    },
    {
      "name": "FOUNDER_PRICE_IDR",
      "label": "Harga Founder per bulan (Rp)",
      "description": "Kosong = 15000. Dipakai hanya kalau paywall dan gateway pembayaran diisi.",
    },
    {
      "name": "BILLING_PROVIDER",
      "label": "Gateway pembayaran",
      "description": "doku atau pakasir, untuk aplikasi versi lama yang belum punya pilihan QRIS/Transfer Bank. Kosong = DOKU kalau diisi, kalau tidak Pakasir.",
    },
    {
      "name": "DOKU_CLIENT_ID",
      "label": "DOKU Client ID",
      "description": "Opsional, tombol Transfer Bank untuk paket Founder lewat DOKU Checkout. Pembayaran aktif hanya kalau batas scan gratis juga diisi.",
      "docs_url": "https://dashboard.doku.com",
    },
    { "name": "DOKU_SECRET_KEY", "label": "DOKU Secret Key", "secret": true },
    {
      "name": "DOKU_BASE_URL",
      "label": "DOKU API URL",
      "description": "Kosong = produksi (https://api.doku.com). Sandbox: https://api-sandbox.doku.com",
    },
    {
      "name": "PAKASIR_SLUG",
      "label": "Pakasir slug proyek",
      "description": "Opsional, tombol QRIS lewat Pakasir. Webhook proyek: <alamatmu>/api/billing/pakasir/webhook",
      "docs_url": "https://pakasir.com/p/get-started",
    },
    { "name": "PAKASIR_API_KEY", "label": "Pakasir API key", "secret": true },
    { "name": "PAKASIR_WEBHOOK_SECRET", "label": "Pakasir webhook secret", "secret": true },
    {
      "name": "PAKASIR_SANDBOX",
      "label": "Terima pembayaran sandbox Pakasir",
      "description": "Isi 1 hanya untuk uji coba: pembayaran sandbox ikut mengaktifkan Founder.",
    },
    {
      "name": "APPLE_BUNDLE_ID",
      "label": "Apple Bundle ID",
      "description": "Kosong = com.joyodigitama.joyorogo. Harus sama dengan produk di App Store Connect.",
    },
    {
      "name": "APPLE_SANDBOX_EMAILS",
      "label": "Email Pembelian Sandbox Apple",
      "description": "Email (pisahkan dengan koma) yang boleh memakai pembelian sandbox/TestFlight: akunmu dan akun demo App Review.",
    },
  ],
}
